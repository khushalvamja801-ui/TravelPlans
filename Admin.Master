<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="TravelPlans.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin – Travel Plans</asp:ContentPlaceHolder>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/css/site.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/css/admin.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/css/responsive.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="adminMasterForm" runat="server">

        <!-- Admin overlay for mobile sidebar -->
        <div id="adminOverlay" class="admin-overlay"></div>

        <!-- ===== ADMIN SIDEBAR ===== -->
        <aside id="adminSidebar" class="admin-sidebar" role="navigation" aria-label="Admin Navigation">
            <!-- Logo -->
            <div class="admin-sidebar-logo">
                <div class="admin-sidebar-logo-icon" aria-hidden="true">✈</div>
                <div>
                    <div class="admin-sidebar-logo-text">TravelPlans</div>
                    <span class="admin-sidebar-logo-sub">Admin Panel</span>
                </div>
            </div>

            <!-- Nav -->
            <nav class="admin-nav">
                <div class="admin-nav-section-label">Overview</div>
                <a href="<%= ResolveUrl("~/Pages/Admin/Dashboard.aspx") %>" class="admin-nav-item <%= GetActiveClass("Dashboard") %>">
                    <span class="nav-icon">📊</span> Dashboard
                </a>

                <hr class="admin-nav-divider" />
                <div class="admin-nav-section-label">Management</div>
                <a href="<%= ResolveUrl("~/Pages/Admin/Packages.aspx") %>" class="admin-nav-item <%= GetActiveClass("Packages") %>">
                    <span class="nav-icon">🗺</span> Packages
                </a>
                <a href="<%= ResolveUrl("~/Pages/Admin/Bookings.aspx") %>" class="admin-nav-item <%= GetActiveClass("Bookings") %>">
                    <span class="nav-icon">📅</span> Bookings
                </a>
                <a href="<%= ResolveUrl("~/Pages/Admin/Users.aspx") %>" class="admin-nav-item <%= GetActiveClass("Users") %>">
                    <span class="nav-icon">👥</span> Users
                </a>

                <hr class="admin-nav-divider" />
                <div class="admin-nav-section-label">System</div>
                <a href="<%= ResolveUrl("~/") %>" class="admin-nav-item">
                    <span class="nav-icon">🏠</span> Public Site
                </a>
                <a href="<%= ResolveUrl("~/Pages/Authentication/SignIn.aspx") %>" class="admin-nav-item">
                    <span class="nav-icon">🚪</span> Sign Out
                </a>
            </nav>
        </aside>

        <!-- ===== ADMIN MAIN ===== -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div style="display:flex;align-items:center;gap:1rem;">
                    <button id="adminSidebarToggle" type="button" style="background:none;border:none;cursor:pointer;font-size:1.4rem;display:none;" aria-label="Toggle sidebar">☰</button>
                    <div class="admin-topbar-title">
                        <asp:ContentPlaceHolder ID="PageTitle" runat="server">Dashboard</asp:ContentPlaceHolder>
                    </div>
                </div>
                <div class="admin-topbar-actions">
                    <div class="admin-user-chip">
                        <div class="avatar" aria-hidden="true">A</div>
                        <span>Admin</span>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <div class="admin-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>

            <!-- Footer -->
            <div style="padding:1rem 1.5rem;border-top:1px solid var(--color-border);font-size:0.75rem;color:var(--color-text-muted);">
                &copy; 2025 TravelPlans Admin &mdash; Demo application only. No real data is stored.
            </div>
        </div>

    </form>

    <script src="<%= ResolveUrl("~/Content/js/site.js") %>"></script>
    <script>
        // Show hamburger on small screens
        (function () {
            var toggle = document.getElementById('adminSidebarToggle');
            if (toggle) toggle.style.display = window.innerWidth < 992 ? 'block' : 'none';
            window.addEventListener('resize', function () {
                if (toggle) toggle.style.display = window.innerWidth < 992 ? 'block' : 'none';
            });
        })();
    </script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
